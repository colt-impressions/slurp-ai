# Verbose Logging
SLURP_VERBOSE=true             # Enable detailed logging (true/false)

# Base paths
SLURP_BASE_PATH=                # Base path for all operations (default: process.cwd())
SLURP_COMPILED_DIR=slurp_docs        # Output directory for the final compiled markdown file
SLURP_PARTIALS_DIR=slurp_partials  # Directory for intermediate scraped markdown files (used as input for compile)

# Scraping configuration
SLURP_MAX_PAGES_PER_SITE=0     # Maximum pages to scrape per site (0 for unlimited)
SLURP_CONCURRENCY=5           # Number of pages to process concurrently
SLURP_RETRY_COUNT=3             # Number of times to retry failed requests
SLURP_RETRY_DELAY=1000          # Delay between retries in milliseconds
SLURP_USE_HEADLESS=true         # Whether to use headless browser for JS content

# URL filtering
SLURP_ENFORCE_BASE_PATH=true    # Whether to enforce base path in URLs
SLURP_PRESERVE_QUERY_PARAMS=version,lang,theme,key,ref  # Query parameters to preserve (added key,ref for PrintSmith)

# Compilation options
SLURP_PRESERVE_METADATA=true    # Whether to preserve metadata in compiled docs
SLURP_REMOVE_NAVIGATION=true    # Whether to remove navigation elements
SLURP_REMOVE_DUPLICATES=true    # Whether to remove duplicate content
SLURP_DELETE_PARTIALS=false      # Whether to delete the partials directory after successful compilation (true/false)

# Custom enhancements for PrintSmith documentation
SLURP_DOC_PATTERNS=/PrintSmith/HtmlHelp/,/Introduction/,/Point_of_Sale_/,/Account_Receivable_/  # Custom doc path patterns
SLURP_MAX_PATH_DEPTH=10          # Maximum path depth before filtering (default: 5)
SLURP_WAIT_FOR_JAVASCRIPT=3000   # Time to wait for JavaScript execution in ms (0 to disable)
